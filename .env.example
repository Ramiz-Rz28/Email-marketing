# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---- Clerk (auth; one Organization per merchant store) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/overview
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/overview

# ---- Supabase Postgres (use the Session/Transaction pooler URL in production) ----
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Direct (non-pooled) URL used by pg-boss + migrations (needs LISTEN/NOTIFY + DDL)
DATABASE_DIRECT_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ---- Shopify custom app (standalone app connecting via OAuth; NOT embedded) ----
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_customers,read_orders,read_products,read_checkouts,read_marketing_events,write_discounts
SHOPIFY_API_VERSION=2026-07

# ---- Resend ----
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
RESEND_FROM_DEFAULT="Store <hello@microsoft.com>"

# ---- Anthropic (campaign briefs; prompt caching on) ----
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5

# ---- Worker ----
WORKER_CONCURRENCY=4
